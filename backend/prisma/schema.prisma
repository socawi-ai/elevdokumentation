generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  group     String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentGrades   AssignmentGrade[]
  nationalTestGrades NationalTestGrade[]
  courseNotes        CourseNote[]
}

// Referenced by name (not a surrogate id) from every per-course table, with
// onUpdate: Cascade so renaming a course is a single update on this row.
model Course {
  name                String  @id
  sortOrder           Int     @default(0)
  // Which side of the duplex PDF sheet the course is printed on (1 or 2).
  page                Int     @default(1)
  // JSON array of delprov names, e.g. ["Delprov A","Delprov B"]; "[]" means
  // the course has no nationella prov.
  nationalTestDelprov String  @default("[]")
  showNationalTest    Boolean @default(false)

  assignments        Assignment[]
  nationalTestGrades NationalTestGrade[]
  courseNotes        CourseNote[]
  groupCourses       GroupCourse[]
}

// Which courses a klass takes. A klass with no rows here takes every course,
// so a new klass (or one never configured) gets the full PDF by default.
model GroupCourse {
  group  String
  course String

  courseRef Course @relation(fields: [course], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@id([group, course])
}

model Assignment {
  id        String   @id @default(cuid())
  course    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  courseRef Course            @relation(fields: [course], references: [name], onDelete: Cascade, onUpdate: Cascade)
  grades    AssignmentGrade[]
}

model AssignmentGrade {
  id           String @id @default(cuid())
  studentId    String
  assignmentId String
  grade        String

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([studentId, assignmentId])
}

model NationalTestGrade {
  id        String @id @default(cuid())
  studentId String
  course    String
  delprov   String
  grade     String

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseRef Course  @relation(fields: [course], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@unique([studentId, course, delprov])
}

model CourseNote {
  id           String @id @default(cuid())
  studentId    String
  course       String
  notes        String @default("")
  summaryGrade String @default("")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseRef Course  @relation(fields: [course], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@unique([studentId, course])
}
